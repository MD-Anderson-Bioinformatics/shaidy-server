# This script is used to manually initialize a new shaidy server during deployment

if [ $# -ne 1 ] ; then
    echo Usage: $0 repo-directory
    exit 1
elif [ ! -d $1 ] ; then
    echo $1 is not a directory
    exit 1
else
    xxx=$( ls -A $1 )
    if [ ${#xxx[@]} -gt 1 ] ; then
        echo $1 is not empty
        exit 1
    fi
    base=`dirname $0`/shaidyserver.build/example.repo
    if [ ! -d $base ] ; then
        echo Cannot find example.repo.  Something strange going on.
        exit 1
    fi
    echo Initializing shaidy repository in folder $1
    rsync -a $base/ $1/
    mkdir -p $1/collection/users $1/file $1/compendium
fi
